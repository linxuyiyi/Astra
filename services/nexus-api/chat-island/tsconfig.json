{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/api": ["./src/shims/api.ts"],
      "@/context/AudioContext": ["./src/shims/AudioContext.tsx"],
      "@/components/dialog/WorkingDirectoryDialog": ["./src/shims/WorkingDirectoryDialog.tsx"],
      "@/lib/browserWebRTCTransport": ["./src/shims/browserWebRTCTransport.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
