# Nexus v1.4.4 生产部署配置模板。
# 只面向独立 Nexus；不兼容旧版 Astra 数据或同机并行部署。
# 复制到 /etc/nexus/nexus.env（chmod 600）。部署只读取该文件，不覆盖已有值。
# 密钥放 /etc/nexus/secrets.env，由部署首次生成，不要提交到仓库。
# 部署不会读取或修改 $HOME/.config/opencode/opencode.json。

# ---- 版本锁定（必填）----
NEXUS_REPO_URL=https://github.com/linxuyiyi/Astra
# 必须是完整 40 位 commit；禁止分支名或短哈希。
NEXUS_COMMIT=

# ---- 路径（可按需覆盖）----
NEXUS_RELEASES_DIR=/opt/nexus/releases
NEXUS_CURRENT_LINK=/opt/nexus/current
NEXUS_CONFIG_DIR=/etc/nexus
NEXUS_STATE_DIR=/var/lib/nexus
NEXUS_DATA_ROOT=/var/lib/nexus/data
NEXUS_LOG_DIR=/var/log/nexus
NEXUS_BACKUP_DIR=/var/lib/nexus/backups
NEXUS_SYSTEMD_UNIT_DIR=/etc/systemd/system
NEXUS_NGINX_CONF=/etc/nginx/conf.d/nexus.conf
NEXUS_NGINX_ENABLED=true
NEXUS_NGINX_PORT=80
NEXUS_ENTRY_URL=http://127.0.0.1/
NEXUS_KEEP_RELEASES=5

# 运行账号与监听。服务默认只监听 loopback，由同机 Nginx 对外。
NEXUS_RUN_USER=nexus
NEXUS_RUN_GROUP=nexus
NEXUS_BIND_HOST=127.0.0.1

# ---- 端口（脚本、systemd、Nginx 共用）----
NEXUS_TASK_API_PORT=18100
NEXUS_GATEWAY_PORT=18110
NEXUS_NEXUS_API_PORT=18120
NEXUS_LIBRARY_MCP_PORT=18201
NEXUS_TASK_MCP_PORT=18202
NEXUS_AGENT_SERVICE_PORT=18000
NEXUS_OPENCODE_PORT=14096
NEXUS_ASSISTANT_OPENCODE_PORT=14097

# ---- 数据库 ----
ASTRA_DATABASE_BACKEND=sqlite
# 生产建议 MySQL。MySQL 升级前必须设置 NEXUS_MYSQL_BACKUP_ACKNOWLEDGED=1，
# 并确认已按人工手册演练恢复；部署不会声称自动无损回滚。
# ASTRA_DATABASE_BACKEND=mysql
ASTRA_DATABASE_HOST=127.0.0.1
ASTRA_DATABASE_PORT=3306
ASTRA_DATABASE_NAME=nexus
ASTRA_DATABASE_USERNAME=nexus
# 密码放 secrets.env，不要写在这里。
# NEXUS_MYSQL_BACKUP_ACKNOWLEDGED=1

# ---- 模型上游 ----
# 显式 provider/model/base URL；部署写入 Nexus 专属 OpenCode 配置。
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
NEXUS_OPENCODE_PROVIDER=nexus
# 可覆盖为内部模型网关地址；OpenCode 使用 <baseURL>/v1。
# ASTRA_OPENCODE_BINARY=/usr/local/bin/opencode

# ---- 必需/启用模块 ----
ASTRA_GATEWAY_ENABLED=true
# 可选：只读探针 key。留空时首次启动后由部署通过 Gateway API 创建并写入
# /etc/nexus/secrets.env（0600），重复部署复用；不会自动覆盖已有 key。
# 放在 secrets.env 或这里（不要提交真实值）。
NEXUS_GATEWAY_PROBE_KEY=
# stdio 表示不启用 Library MCP；streamable-http 时 Library MCP 为必需服务。
ASTRA_MCP_TRANSPORT=streamable-http
ASTRA_REDIS_URL=redis://127.0.0.1:6379/1

# ---- 可选模块（核心部署不检查、不安装）----
# 启用后运行：ops/deploy/install_nexus.sh optional-wiki
ASTRA_LLM_WIKI_ENABLED=false
LLM_WIKI_BUNDLE=
LLM_WIKI_HOST=
LLM_WIKI_LOCAL_PORT=19828
LLM_WIKI_REMOTE_PORT=18080
LLM_WIKI_SSH_PASSWORD=

# 启用后运行：ops/deploy/install_nexus.sh optional-remote-worker --remote-worker HOST
REMOTE_WORKER_ID=nexus-remote
REMOTE_WORKER_USER=root
REMOTE_WORKER_PORT=22
REMOTE_WORKER_SSH_PASSWORD=
REMOTE_WORKER_OPENCODE_PORT=14096
REMOTE_WORKER_WORKSPACE=/root/nexus-remote
