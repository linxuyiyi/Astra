# Nexus 环境变量模板。
# 使用方法：复制为根目录 .env（.env 已被 .gitignore 忽略），或直接导出为进程环境变量。
# 这里只放占位符，绝不提交真实密钥。AgentScope 服务与 Nexus 后端读取同一份根 .env。

# ---- AgentScope 服务监听（仅回环，供 Nexus 后端经 HTTP 访问）----
AGENTSCOPE_SERVICE_HOST=127.0.0.1
AGENTSCOPE_SERVICE_PORT=8766

# ---- AgentScope 持久化目录（相对路径时基于仓库根目录解析）----
AGENTSCOPE_DATA_DIR=data/agentscope

# ---- 内部服务租户（Nexus 后端以该身份调用 AgentScope，非浏览器身份）----
AGENTSCOPE_INTERNAL_USER_ID=nexus-service

# ---- 默认模型绑定：由 AgentScope 服务统一管理，Nexus 页面不提供模型配置入口 ----
# 缺少 AGENTSCOPE_MODEL_API_KEY 时服务仍可启动，但 /nexus/defaults 会报告模型未配置。
AGENTSCOPE_MODEL_API_KEY=
AGENTSCOPE_MODEL_BASE_URL=https://api.deepseek.com
AGENTSCOPE_MODEL_NAME=deepseek-flash
# 可选：默认模型 parameters（JSON 对象）。留空则使用官方合理默认值，不擅自添加额外模型。
# 示例：AGENTSCOPE_MODEL_PARAMETERS={"max_tokens":1024,"thinking":false}
AGENTSCOPE_MODEL_PARAMETERS=

# ---- Nexus 业务后端（仅回环）----
NEXUS_BACKEND_HOST=127.0.0.1
NEXUS_BACKEND_PORT=8765
NEXUS_BACKEND_DATA_DIR=data/nexus-backend
# 后端连接的 AgentScope 服务地址（仅回环 http(s)）。
AGENTSCOPE_SERVICE_URL=http://127.0.0.1:8766
# 可选：上游请求/连接超时（秒）。
NEXUS_BACKEND_REQUEST_TIMEOUT=30
NEXUS_BACKEND_CONNECT_TIMEOUT=5
