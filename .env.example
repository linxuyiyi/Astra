# Nexus 环境变量模板。
# 使用方法：复制为根目录 .env（.env 已被 .gitignore 忽略），或直接导出为进程环境变量。
# 这里只放占位符，绝不提交真实密钥。AgentScope 服务与 Nexus 后端读取同一份根 .env。

# ---- AgentScope 服务监听（仅回环，供 Nexus 后端经 HTTP 访问）----
AGENTSCOPE_SERVICE_HOST=127.0.0.1
AGENTSCOPE_SERVICE_PORT=8766

# ---- AgentScope 持久化目录（相对路径时基于仓库根目录解析）----
AGENTSCOPE_DATA_DIR=data/agentscope

# ---- 内部服务租户（Nexus 后端以该身份调用 AgentScope，非浏览器身份）----
AGENTSCOPE_INTERNAL_USER_ID=nexus-service

# ---- 默认模型绑定：由 AgentScope 服务统一管理，Nexus 页面不提供模型配置入口 ----
# 缺少 AGENTSCOPE_MODEL_API_KEY 时服务仍可启动，但 /nexus/defaults 会报告模型未配置。
AGENTSCOPE_MODEL_API_KEY=
AGENTSCOPE_MODEL_BASE_URL=https://api.deepseek.com
AGENTSCOPE_MODEL_NAME=deepseek-flash
# 可选：默认模型 parameters（JSON 对象）。留空则使用官方合理默认值，不擅自添加额外模型。
# 示例：AGENTSCOPE_MODEL_PARAMETERS={"max_tokens":1024,"thinking":false}
AGENTSCOPE_MODEL_PARAMETERS=

# ---- 可选：知识库功能（默认关闭）----
# 未开启时官方 /knowledge_bases/ 返回 503，Nexus 资源目录明确标记不可用，
# 不伪装为空目录。开启需交付依赖 qdrant-client 与 agentscope[model-ollama]，
# 并另行在服务端创建知识库（原生 CRUD）；没有任何向量/blob 目录的产品页面。
AGENTSCOPE_KNOWLEDGE_ENABLED=false
# 向量/blob 目录默认从实际 AGENTSCOPE_DATA_DIR 派生（data/agentscope/knowledge/
# vector、.../blobs），隔离实例不会写入项目默认 data；如需显式指定可按项目根
# 相对路径或绝对路径配置。
# AGENTSCOPE_KNOWLEDGE_VECTOR_DIR=data/agentscope/knowledge/vector
# AGENTSCOPE_KNOWLEDGE_BLOB_DIR=data/agentscope/knowledge/blobs

# ---- 可选：知识库本地 embedding（Ollama，模型层依赖）----
# 官方 OllamaEmbeddingModel 通过 OllamaCredential 记录连接信息；Ollama 服务由
# 部署方提供并启停，本服务不管理也不自动启停该外部进程。固定 credential id
# 使每次启动命中同一条原生记录（重启复用）。缺少 Ollama 或模型时明确不可用。
AGENTSCOPE_EMBEDDING_HOST=http://127.0.0.1:11434
AGENTSCOPE_EMBEDDING_MODEL=embeddinggemma:300m
AGENTSCOPE_EMBEDDING_DIMENSIONS=768
AGENTSCOPE_EMBEDDING_CREDENTIAL_ID=nexus-default-ollama-embedding
AGENTSCOPE_EMBEDDING_CREDENTIAL_NAME=nexus-default-embedding

# ---- 回环代理绕过（手动启动时请自行导出）----
# scripts/services.py 启动子进程时会自动在 NO_PROXY/no_proxy 中补入
# 127.0.0.1,localhost,::1（保留既有列表）。手动 `python -m nexus_agent_service`
# 时若不绕过代理，AgentScope→本机 Ollama 调用可能被系统代理拦截。
# NO_PROXY=127.0.0.1,localhost,::1

# ---- 服务端内部秘密：运行 guard 回调鉴权（两个进程共享，绝不下发前端）----
# 留空时 scripts/services.py 会在 data/.nexus-internal-token 生成并复用，用于
# 本机受控验证；正式部署应由部署系统注入同一值，切勿提交或下发浏览器。
NEXUS_INTERNAL_TOKEN=
# AgentScope 回调 Nexus 内部授权端点的地址（仅回环）。手动启动时可留空使用默认。
NEXUS_GUARD_URL=http://127.0.0.1:8765

# ---- Nexus 业务后端（仅回环）----
NEXUS_BACKEND_HOST=127.0.0.1
NEXUS_BACKEND_PORT=8765
NEXUS_BACKEND_DATA_DIR=data/nexus-backend
# 后端连接的 AgentScope 服务地址（仅回环 http(s)）。
AGENTSCOPE_SERVICE_URL=http://127.0.0.1:8766
# 可选：上游请求/连接超时（秒）。
NEXUS_BACKEND_REQUEST_TIMEOUT=30
NEXUS_BACKEND_CONNECT_TIMEOUT=5
