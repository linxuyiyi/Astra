  "git_diff": "diff --git a/result_summary.py b/result_summary.py\nindex 4c4f8ae..41fb89a 100644\n--- a/result_summary.py\n+++ b/result_summary.py\n@@ -1,2 +1,18 @@\n def summarize(rows):\n-    return {\"total\": len(rows), \"passed\": sum(row[\"status\"] == \"passed\" for row in rows)}\n+    \"\"\"Summarize the latest event per (run_id, case_id) group.\n+\n+    Rows are grouped by (run_id, case_id). Within a group the row with the\n+    greatest event_time decides the status; on an exact event_time tie the\n+    last row in input order wins because replacement uses \">=\". The result\n+    keeps the existing shape: total is the number of groups and passed counts\n+    groups whose chosen status is PASS.\n+    \"\"\"\n+    latest = {}\n+    for row in rows:\n+        key = (row[\"run_id\"], row[\"case_id\"])\n+        if key not in latest or row[\"event_time\"] >= latest[key][\"event_time\"]:\n+            latest[key] = row\n+\n+    total = len(latest)\n+    passed = sum(1 for row in latest.values() if row[\"status\"] == \"PASS\")\n+    return {\"total\": total, \"passed\": passed}\n",
