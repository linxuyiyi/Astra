# Nexus 唯一环境模板。复制为 ops/env/.env（chmod 600）后填写。
# 本地启动脚本和 install_nexus.sh 只读取 ops/env/.env。
# 安装时，当前进程里已经导出的变量优先于该文件。
# 只放占位符。不要把密钥、credential id 或 SSH 密码写进仓库。

# ---- 安装（ops/deploy/install_nexus.sh）----
# 发布前把仓库地址和分支指向实际远端；分支必须先推送。
NEXUS_REPO_URL=https://github.com/linxuyiyi/Astra
NEXUS_BRANCH=v1.4.8
NEXUS_ROOT=/opt/nexus
NEXUS_STATE_DIR=/var/lib/nexus
NEXUS_BIND_HOST=127.0.0.1

# ---- 模型 ----
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash

# Agent Service 使用独立的 SQL 数据库。模型 credential 由员工选定的网关路由登记。
# 两个库先由 DBA 创建并授权，密码和特殊字符需要 URL 编码。公司版本为 MySQL 8.0.36。
AGENTSCOPE_SQL_URL=mysql+asyncmy://nexus_agent:REPLACE_ME@127.0.0.1:3306/nexus_agentscope?charset=utf8mb4

# ---- 统一服务（services/nexus-api，端口 18120 / 18110 / 18201 / 18202）----
ASTRA_ENVIRONMENT=development
ASTRA_DATABASE_URL=mysql+asyncmy://nexus:REPLACE_ME@127.0.0.1:3306/nexus?charset=utf8mb4
# URL 为唯一部署连接配置。以下字段供不设置 URL 的手动开发环境使用。
# 显式 SQLite 开发：ASTRA_DATABASE_URL=sqlite+aiosqlite:////absolute/path/nexus.db
ASTRA_DATABASE_BACKEND=mysql
ASTRA_DATABASE_HOST=127.0.0.1
ASTRA_DATABASE_PORT=3306
ASTRA_DATABASE_NAME=nexus
ASTRA_DATABASE_USERNAME=nexus
ASTRA_DATABASE_PASSWORD=
ASTRA_DATABASE_CHARSET=utf8mb4
ASTRA_DATABASE_POOL_RECYCLE=1800
ASTRA_DATA_DIR=services/nexus-api/data
ASTRA_WORKSPACE_ROOT=services/nexus-api/workspaces
ASTRA_LOG_DIR=.astra/logs
ASTRA_RUNTIME_DIR=.astra/run
ASTRA_CONFIG_DIR=services/nexus-api/configs
ASTRA_SEED_DEMO=false
ASTRA_REDIS_URL=redis://127.0.0.1:6379/1
# Worker Gateway 默认 auto：上面的 URL 非空就用 Redis。置空 URL 会退回 memory，
# 健康检查提示仅单进程可用。需要覆盖时再设 NEXUS_WORKER_GATEWAY_BUS=memory|redis。
# 管理接口密钥。留空时由 ops/dev/astra_service.py 在拉起 API 前生成一次并写回本文件。
# API 进程不各自生成。WebSocket 不使用这把密钥。
# NEXUS_WORKER_GATEWAY_ADMIN_KEY=

ASTRA_EXECUTOR_TYPE=opencode_server
ASTRA_OPENCODE_BINARY=opencode
ASTRA_OPENCODE_AGENT=
# Worker / OpenCode 默认。对话仍用 OPENAI_MODEL=deepseek-flash。
ASTRA_OPENCODE_MODEL=deepseek/deepseek-flash
ASTRA_OPENCODE_TIMEOUT_SECONDS=3600
ASTRA_OPENCODE_SERVER_HOSTNAME=127.0.0.1
ASTRA_OPENCODE_SERVER_PORT=14096
ASTRA_OPENCODE_SERVER_USERNAME=opencode
ASTRA_OPENCODE_SERVER_VERSION=1.18.35
ASTRA_OPENCODE_SERVER_VERSION_CHECK_ENABLED=true
# ASTRA_OPENCODE_SERVER_PASSWORD=

ASTRA_NEXUS_API_BASE=http://127.0.0.1:18120
ASTRA_AGENTSCOPE_BASE_URL=http://127.0.0.1:18000
ASTRA_AGENTSCOPE_USER_ID=nexus
NEXUS_TASK_MCP_HOST=127.0.0.1
NEXUS_TASK_MCP_PORT=18202
# 与 NEXUS_TASK_MCP_KEY 必须相同。留空时 Task MCP 拒绝所有调用。
# NEXUS_TASK_MCP_KEY=
ASTRA_OUTBOX_INTERVAL=2
ASTRA_OUTBOX_RETRY_SECONDS=5
ASTRA_INACTIVITY_TIMEOUT=900
ASTRA_RECOVERY_INTERVAL=30
ASTRA_RUNTIME_STARTUP_TIMEOUT=120
ASTRA_RUNTIME_HEARTBEAT_TIMEOUT=90

NEXUS_MCP_TRANSPORT=stdio
NEXUS_MCP_HOST=127.0.0.1
NEXUS_MCP_PORT=18201
NEXUS_MCP_STREAMABLE_HTTP_PATH=/mcp
# NEXUS_MCP_API_KEY=
# NEXUS_MCP_ISSUER_URL=https://nexus.example.internal
# NEXUS_MCP_RESOURCE_SERVER_URL=https://nexus.example.internal/mcp

ASTRA_GATEWAY_ENABLED=true
ASTRA_GATEWAY_PROBE_TIMEOUT_SECONDS=30
# ---- 任务经验复盘（独立 Gateway 推理，不创建 AgentScope Agent）----
# 默认关闭；开启后人工确认完成会创建复盘 Job。
NEXUS_EXPERIENCE_REVIEW_ENABLED=false
NEXUS_EXPERIENCE_REVIEW_SHADOW_MODE=true
NEXUS_EXPERIENCE_REVIEW_GATEWAY_URL=http://127.0.0.1:18110/v1/chat/completions
NEXUS_EXPERIENCE_REVIEW_MODEL=deepseek-flash
# 空则复用 NEXUS_GATEWAY_API_KEY；生产建议单独签发只读复盘 Key。
# NEXUS_EXPERIENCE_REVIEW_GATEWAY_KEY=
NEXUS_EXPERIENCE_REVIEW_CONTEXT_TOKENS=32768
NEXUS_EXPERIENCE_REVIEW_MAP_INPUT_TOKENS=8000
NEXUS_EXPERIENCE_REVIEW_REDUCE_INPUT_TOKENS=8000
NEXUS_EXPERIENCE_REVIEW_MAX_ATTEMPTS=3
NEXUS_EXPERIENCE_REVIEW_MAX_CANDIDATES=3
NEXUS_EXPERIENCE_REVIEW_MAX_MESSAGES=50000
NEXUS_EXPERIENCE_REVIEW_MAX_SOURCE_BYTES=536870912
NEXUS_EXPERIENCE_REVIEW_MAX_CONCURRENCY=2
NEXUS_EXPERIENCE_REVIEW_SCAN_INTERVAL=30
NEXUS_EXPERIENCE_REVIEW_LEASE_SECONDS=600
NEXUS_EXPERIENCE_REVIEW_PAGE_SIZE=20
# 人工确认时的用量采集上限；超过后按已读消息计算。
NEXUS_FINAL_USAGE_MAX_MESSAGES=5000
# ASTRA_GATEWAY_MASTER_KEY=
ASTRA_SERVICE_GATEWAY_HOST=127.0.0.1
ASTRA_SERVICE_GATEWAY_PORT=18110
# 开发模式可选：单独起 Vite 时使用；生产由 nexus-api 托管 dist。
ASTRA_SERVICE_FRONTEND_HOST=0.0.0.0
ASTRA_SERVICE_FRONTEND_PORT=15174

ASTRA_NR_TEST_SYSTEM_ENDPOINT=http://localhost:8000
ASTRA_NR_TEST_SYSTEM_DISCOVER_PATH=/api/astra/tasks
ASTRA_NR_TEST_SYSTEM_RESULT_PATH=/api/astra/tasks/{external_task_id}/result
ASTRA_NR_TEST_SYSTEM_TOKEN=

NEXUS_REMOTE_OPENCODE_VERSION=1.18.35
NEXUS_REMOTE_NODE_VERSION=22.23.3
NEXUS_REMOTE_NPM_REGISTRY=https://registry.npmmirror.com
# 远端已安装的 Python ≥ 3.11。空则使用 python3。Ubuntu 22.04 可填 /usr/bin/python3.12
# NEXUS_REMOTE_PYTHON=
# 可选。设置后传给远端 pip 的 -i
# NEXUS_REMOTE_PIP_INDEX_URL=
NEXUS_REMOTE_DEPLOY_TIMEOUT_SECONDS=1200
# 部署拒绝回环。改成 Worker 能访问的内网地址，例如 http://10.0.0.8:18110
NEXUS_REMOTE_GATEWAY_LOCAL_URL=http://127.0.0.1:18110
# Worker Agent 拨入的 WebSocket。部署拒绝空值和回环。
# NEXUS_WORKER_AGENT_GATEWAY_URL=ws://10.0.0.8:18120/api/worker-gateway/connect
# Agent Worker 维护执行器与只读健康观测。
NEXUS_WORKER_MAINTENANCE_LEASE_SECONDS=60
NEXUS_WORKER_MAINTENANCE_POLL_SECONDS=1
NEXUS_WORKER_HEALTH_INTERVAL_SECONDS=30
NEXUS_WORKER_HEALTH_MAX_AGE_SECONDS=90
NEXUS_OPENCODE_CONTROL_TIMEOUT_SECONDS=60
# NEXUS_WORKER_CHILD_ENV_ALLOW=OPTIONAL_EXTRA_ENV
NEXUS_SSH_CONNECT_TIMEOUT_SECONDS=10

# ---- Nexus API（services/nexus-api，端口 18120）----
NEXUS_DATA_DIR=services/nexus-api/data
NEXUS_AGENTSCOPE_BASE_URL=http://127.0.0.1:18000
NEXUS_AGENTSCOPE_USER_ID=nexus
NEXUS_TASK_MCP_URL=http://127.0.0.1:18202/mcp
# 与 NEXUS_TASK_MCP_KEY 必须相同。Nexus 把它放进 Session 绑定的 MCP 请求头。
# NEXUS_TASK_MCP_KEY=
NEXUS_CHAT_PROVIDER=openai
# 本机没有付费密钥时可改为 ollama，并设置 NEXUS_OLLAMA_HOST / NEXUS_OLLAMA_MODEL。
# NEXUS_CHAT_PROVIDER=ollama
# NEXUS_OLLAMA_HOST=http://127.0.0.1:11434
# NEXUS_OLLAMA_MODEL=qwen2.5:3b

# ---- Agent Service（services/agent-service，端口 18000）----
NEXUS_API_BASE=http://127.0.0.1:18120
AGENTSCOPE_HOST=0.0.0.0
AGENTSCOPE_PORT=18000
AGENTSCOPE_REDIS_HOST=127.0.0.1
AGENTSCOPE_REDIS_PORT=6379
AGENTSCOPE_REDIS_DB=1
AGENTSCOPE_REDIS_PASSWORD=
AGENTSCOPE_WORKSPACE_DIR=services/agent-service/data/workspaces

# ---- llm_wiki（tools/llm_wiki，--with-llm-wiki）----
ASTRA_LLM_WIKI_ENABLED=false
ASTRA_LLM_WIKI_API_BASE_URL=http://127.0.0.1:19828/api/v1
ASTRA_LLM_WIKI_API_TOKEN=
ASTRA_LLM_WIKI_PROJECT_ID=
ASTRA_LLM_WIKI_TIMEOUT=30
LLM_WIKI_HOST=
LLM_WIKI_SSH_USER=root
# LLM_WIKI_SSH_KEY=$HOME/.ssh/llmwiki_tunnel
LLM_WIKI_SSH_PASSWORD=
LLM_WIKI_BUNDLE=
LLM_WIKI_REMOTE_PORT=18080
LLM_WIKI_LOCAL_PORT=19828
LLM_WIKI_API_TOKEN=
LLM_WIKI_PROJECT_ID=

# ---- 远程 Worker（--remote-worker）----
REMOTE_WORKER_ID=p2-remote
REMOTE_WORKER_USER=root
REMOTE_WORKER_PORT=22
REMOTE_WORKER_SSH_PASSWORD=
REMOTE_WORKER_OPENCODE_PORT=14096
REMOTE_WORKER_WORKSPACE=/root/nexus-remote
