# Copy to .env for local overrides. systemd also reads EnvironmentFile.
NEXUS_ASR_CONFIG=config.yaml
NEXUS_ASR_HOST=127.0.0.1
NEXUS_ASR_PORT=19899
NEXUS_ASR_LOG_LEVEL=info
NEXUS_ASR_PROVIDER=funasr
# 1 = never access the network; model files must already exist.
NEXUS_ASR_OFFLINE=0
# Optional overrides:
# NEXUS_ASR_MODEL_DIR=./models/SenseVoiceSmall
# NEXUS_ASR_CACHE_DIR=./models/modelscope
# NEXUS_ASR_VAD_MODEL=fsmn-vad
# NEXUS_ASR_NUM_THREADS=4
# NEXUS_ASR_MAX_CONCURRENCY=2
# NEXUS_ASR_AUTO_DOWNLOAD=1
